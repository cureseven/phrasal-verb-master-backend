# local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phrasal_verb_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/phrasal_verb_db?schema=public"

# 認証
JWT_SECRET="change-me-to-a-long-random-string"

# CORS許可オリジン（フロントエンドのURL。カンマ区切りで複数指定可。例: メインドメイン,管理画面サブドメイン）
FRONTEND_URL="http://localhost:3000"

# 管理者アカウントのシード用（npm run seed:adminでのみ使用。実行時には不要）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
